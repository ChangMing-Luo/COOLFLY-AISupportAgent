# COOLFLY 知识运营中台 · 环境变量模板（可提交，禁止填真实值）
# 复制为 .env 后填写：cp .env.example .env

# ---------- Zendesk 集成（integrations/zendesk.ts） ----------
# 认证二选一，OAuth 优先；均不齐 → 落盘沙箱（/healthz 暴露 zendesk 模式）
ZENDESK_SUBDOMAIN=          # https://<subdomain>.zendesk.com

# 方式一（推荐，后台任务无需用户交互）：OAuth client_credentials
ZENDESK_OAUTH_CLIENT_ID=      # 管理中心 → API → OAuth 客户端 → 唯一标识符（字符串，非数字 id）
ZENDESK_OAUTH_CLIENT_SECRET=  # 创建时仅显示一次
ZENDESK_OAUTH_SCOPE=          # 默认 "read write"

# 方式二：API token（Basic Auth）
ZENDESK_EMAIL=              # 管理员/agent 邮箱
ZENDESK_API_TOKEN=          # 管理中心 → API → Zendesk API → 令牌访问

# 内部知识（visibility=internal）推送时绑定的「仅客服」用户细分 id
# 未配置时内部条目同步会被直接拒绝（防公开泄漏），公开条目不受影响
ZENDESK_AGENT_SEGMENT_ID=

# 条目正文 locale（须在 Guide 已启用），默认 zh-cn；英文译文固定走 en-us translations
# 二者相同会互相覆盖，代码会拒绝推送
ZENDESK_LOCALE=

# 沙箱状态文件路径（默认 <cwd>/.sandbox-zendesk.json）
ZENDESK_SANDBOX_FILE=

# ---------- 数据库 ----------
DATABASE_URL=               # 默认 postgres://localhost:5432/kb_console

# ---------- LLM（integrations/llm.ts） ----------
ANTHROPIC_API_KEY=          # 缺失时启用本地确定性 provider
ANTHROPIC_MODEL=            # 默认 claude-sonnet-5

# ---------- 服务 ----------
PORT=                       # 默认 3311
LOG_LEVEL=                  # 默认 info
COOKIE_SECRET=              # 生产必填
LOGIN_RATE_MAX=             # 默认 10 次/分钟
DISABLE_CRON=               # =1 关闭定时任务
SEED_PASSWORD=              # 种子账号初始密码，默认 Coolfly@2026
